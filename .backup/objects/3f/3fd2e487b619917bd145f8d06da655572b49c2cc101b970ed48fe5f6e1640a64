import { lex } from './dist/src/parser/lexer.js';
import { parse } from './dist/src/parser/parser.js';

// Test 1: method call with chained Index.Method
const code1 = 'fadeOutBg.Completed:Connect(function() notif:Destroy() end)';
try {
  const tokens = lex(code1);
  const ast = parse(tokens);
  console.log('[test1] PASSED: parse OK');
  console.log('[test1] first stmt type:', ast.body[0].t);
  console.log('[test1] method name:', ast.body[0].name);
} catch(e) {
  console.log('[test1] FAILED:', e.message);
}

